# Internal GitLab submodule URLs.
#
# The committed .gitmodules points every third_party submodule at its public
# GitHub mirror (git@github.com:XenseRobotics-AI/*). This file keeps the equivalent
# internal GitLab URLs for use on the company network.
#
# The GitLab host is NOT written here — this repository is public, and the host
# address is internal network topology. It comes from the XENSE_GITLAB_HOST
# environment variable, which scripts/submodule-remote.sh substitutes into the
# URLs below. Ask a teammate for the value; it is not recorded in the repo.
#
# Switch with:   XENSE_GITLAB_HOST=<host> scripts/submodule-remote.sh gitlab
#                (then: git submodule update --init --recursive)
# Switch back:   scripts/submodule-remote.sh github
#
# All submodule pins exist on BOTH remotes, so either set of URLs resolves the
# same commits.

[submodule "third_party/ARX5_SDK"]
	path = third_party/ARX5_SDK
	url = git@${XENSE_GITLAB_HOST}:physical-ai/robot_sdk/arx5_sdk.git
[submodule "third_party/libpyflexiv"]
	path = third_party/libpyflexiv
	url = git@${XENSE_GITLAB_HOST}:physical-ai/robot_sdk/libpyflexiv.git
[submodule "third_party/XGripper"]
	path = third_party/XGripper
	url = git@${XENSE_GITLAB_HOST}:physical-ai/grippersdk/xgripper.git
[submodule "third_party/taccap-gripper"]
	path = third_party/taccap-gripper
	url = git@${XENSE_GITLAB_HOST}:physical-ai/grippersdk/taccap-gripper.git
